.DS_Store
.env
# Paradigm (Ofself) CLI secrets: the app's API key and encryption key. Secrets live only here or in .env.
.paradigm/
.idea/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
__pycache__/
*.egg-info/
*.py[cod]
build/
dist/
htmlcov/
.coverage

# All runtime research data is disposable and must remain local. Corridors are kept apart from
# the evidence cache because they expire on a different timescale, but neither is ever committed.
var/cache/*
!var/cache/.gitkeep
var/corridors/*
!var/corridors/.gitkeep
var/recall/*
!var/recall/.gitkeep
var/corpus/*
!var/corpus/.gitkeep
var/pagetext/*
!var/pagetext/.gitkeep
var/usage/*
!var/usage/.gitkeep
# Local backups of the stores, taken before a rebuild or a re-run. Copies of the stores above, so
# never committed either.
var/_backup*/
# Model drafts of a plan (entry 178). Each is written from a whole traveller profile, so it can
# hold a city or a residence status: never commit one.
var/plans/*
!var/plans/.gitkeep
# Travellers' problem reports (TODO item 74): they hold what a traveller was shown.
var/reports/
# Free-plan counts per hashed address (entry 262): a store on each machine, not shared.
var/allowance/

# Machine-local tool settings. The shared launch configuration is tracked.
.claude/settings.local.json

# Raw outputs of item 70's re-runs: packets of government page text, drafts and recall logs.
var/item70-2026-09-24/runs/
var/item70-2026-09-24/fixed/
var/item70-2026-09-24/rebuilt/
var/item70-2026-09-24/next/
var/item70-2026-09-24/anchored/
