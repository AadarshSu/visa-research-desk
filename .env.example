# Secrets and machine-local settings. Copy to .env (never committed) and fill in what you need.
#
# Policy is NOT set here: source mode, extraction mode, render mode, model route and the freshness
# rules are reviewable and live in src/visa_research_agent/config/runtime.yaml.

# --- Model calls -----------------------------------------------------------------------------
# The model every call uses, on either route.
OPENAI_MODEL=gpt-5.6-terra

# Needed when runtime.yaml says `model_route: personas` (the default): Ofself Personas.
# The app id and HMAC key come from `paradigm personas register`; the user id is the Paradigm
# user every call runs as.
PERSONAS_APP_ID=
PERSONAS_HMAC_KEY=
PERSONAS_USER_ID=

# Needed only when runtime.yaml says `model_route: openai`.
OPENAI_API_KEY=

# --- Search ----------------------------------------------------------------------------------
# Brave Search API. Used by the `visa-discover` commands and by every plan request for a
# destination researched automatically. Search only proposes candidates; it never becomes
# evidence until a page passes the domain-trust rules.
SEARCH_API_KEY=

# --- Embeddings (TODO item 67) ------------------------------------------------------------
# Voyage AI, for the offline embedding experiment in var/embed-replay-2026-09-28/ only.
VOYAGE_API_KEY=

# --- Sign-in with Ofself (Paradigm) ----------------------------------------------------------
# Sign-in is on only when the client id, the API key and a session secret are all set.
PARADIGM_CLIENT_ID=
PARADIGM_API_KEY=
# Must be a redirect URI registered on the app.
PARADIGM_REDIRECT_URI=http://localhost:8000/oauth/callback
# Signs the session cookie. Generate a long random value per machine or deployment.
SESSION_SECRET=
# true wherever the app is served over HTTPS; false only for localhost.
SESSION_COOKIE_SECURE=false
# Without an Ofself session a visitor gets this many plans, counted per address; signing in lifts
# the limit (DECISIONS entry 262). Set REQUIRE_SIGN_IN=true to require a session for every plan.
REQUIRE_SIGN_IN=false
ANONYMOUS_PLAN_ALLOWANCE=10

# --- Local storage and retrieval tuning -------------------------------------------------------
CACHE_DIRECTORY=var/cache
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_FETCH_CONCURRENCY=4
MAXIMUM_SOURCE_CHARACTERS=50000
MINIMUM_SOURCE_CHARACTERS=400
